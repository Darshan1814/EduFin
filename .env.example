# ── Public / Client-Side Environment Variables ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Backend / Server-Side Environment Variables ─────────────────────────────
# Groq API Keys (Primary + Automatic Failover Keys)
GROQ_API_KEY=your-groq-api-key
GROQ_FALLBACK_KEY_1=your-groq-fallback-key-1
GROQ_FALLBACK_KEY_2=your-groq-fallback-key-2
GROQ_API_KEY_BACKUP=your-groq-api-key-backup

# Google Gemini API Key (Secondary fallback for admissions & counseling AI)
GEMINI_API_KEY=your-gemini-api-key

# Serper Google News & University Admission Search API
SERPER_API_KEY=your-serper-api-key

# ElevenLabs Multilingual Voice AI (Text-to-Speech for Voice Mock Interviews)
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=gHu9GtaHOXcSqFTK06ux
ELEVENLABS_FALLBACK_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Database & External Integrations
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
GOOGLE_PLACES_API_KEY=your-google-places-key
